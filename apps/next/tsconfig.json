{
  "extends": "../../packages/ts-config/browser.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
