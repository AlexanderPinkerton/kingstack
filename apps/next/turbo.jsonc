{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build", "@kingstack/prisma#generate"],
    },
    "build": {
      "dependsOn": ["^build", "@kingstack/prisma#generate"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
    },
    "test": {
      "dependsOn": ["^build"],
    },
  },
}
