# Dependencies - these are rebuilt inside Docker
node_modules
**/node_modules

# Yarn cache (v4 berry stores cache in .yarn)
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# Build outputs (we rebuild inside Docker)
**/dist
**/build
**/.next
**/.turbo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
**/coverage

# Environment files (secrets - don't bake into image)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Development databases
*.db
*.sqlite

# Docker (avoid recursion)
Dockerfile*
docker-compose*
