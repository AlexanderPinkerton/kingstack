{
  "name": "@kingstack/deploy",
  "version": "0.1.0",
  "author": "Alexander Pinkerton <alexanderpinkerton.business@gmail.com>",
  "license": "MIT",
  "description": "Versioned hosted deployment tooling for KingStack projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderPinkerton/kingstack.git",
    "directory": "packages/deploy"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "king-deploy": "bin/king-deploy"
  },
  "engines": {
    "bun": ">=1.2.8"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/**/*.test.ts",
    "test:package": "bun scripts/smoke-test.ts",
    "test:nest": "bun test src/nest/**/*.test.ts",
    "test:supabase": "bun test src/supabase/**/*.test.ts",
    "test:vercel": "bun test src/vercel/**/*.test.ts"
  },
  "dependencies": {
    "@kingstack/config": "0.3.0",
    "@napi-rs/keyring": "1.2.0"
  },
  "peerDependencies": {
    "supabase": ">=2.113.0 <3",
    "vercel": ">=58.1.0 <59"
  },
  "peerDependenciesMeta": {
    "supabase": {
      "optional": true
    },
    "vercel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kingstack/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "eslint": "10.8.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
