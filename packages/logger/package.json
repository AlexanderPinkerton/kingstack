{
  "name": "@kingstack/logger",
  "version": "0.0.0",
  "description": "Structured, runtime-safe logging for KingStack applications",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderPinkerton/kingstack.git",
    "directory": "packages/logger"
  },
  "keywords": [
    "kingstack",
    "logger",
    "logging",
    "pino",
    "structured-logging"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "pino-pretty": "^13.1.3"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kingstack/eslint-config": "workspace:*",
    "@kingstack/ts-config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "10.8.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "vitest": "^3.1.4"
  }
}
