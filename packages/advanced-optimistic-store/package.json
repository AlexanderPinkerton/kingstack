{
  "name": "@kingstack/advanced-optimistic-store",
  "version": "0.1.0",
  "author": "Alexander Pinkerton <alexanderpinkerton.business@gmail.com>",
  "license": "MIT",
  "description": "Framework-agnostic optimistic and remote updates with MobX + TanStack Query Core",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderPinkerton/kingstack.git",
    "directory": "packages/advanced-optimistic-store"
  },
  "keywords": [
    "mobx",
    "tanstack-query",
    "optimistic-updates",
    "state-management",
    "realtime",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "STATUS.md",
    "docs"
  ],
  "scripts": {
    "build": "yarn clean && tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0",
    "mobx": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@kingstack/eslint-config": "workspace:*",
    "@kingstack/ts-config": "workspace:*",
    "@tanstack/query-core": "5.90.1",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.25.0",
    "mobx": "^6.13.5",
    "prettier": "^3.4.2",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
