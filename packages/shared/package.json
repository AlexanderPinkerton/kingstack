{
  "name": "@kingstack/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript types and code for kingstack apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "devDependencies": {
    "@kingstack/eslint-config": "workspace:*",
    "@kingstack/ts-config": "workspace:*",
    "@types/node": "^22.12.0",
    "eslint": "10.8.0",
    "typescript": "5.9.3"
  },
  "private": true
}
