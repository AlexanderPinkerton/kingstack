{
  "name": "@kingstack/flags",
  "version": "0.1.0",
  "description": "Typed feature flags and identity-scoped snapshots for KingStack",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderPinkerton/kingstack.git",
    "directory": "packages/flags"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "dist/cjs/server.d.ts"
      ],
      "http": [
        "dist/cjs/http.d.ts"
      ],
      "mobx": [
        "dist/cjs/mobx.d.ts"
      ],
      "react": [
        "dist/cjs/react.d.ts"
      ],
      "testing": [
        "dist/cjs/testing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/esm/server.d.ts",
        "default": "./dist/esm/server.js"
      },
      "require": {
        "types": "./dist/cjs/server.d.ts",
        "default": "./dist/cjs/server.js"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/esm/http.d.ts",
        "default": "./dist/esm/http.js"
      },
      "require": {
        "types": "./dist/cjs/http.d.ts",
        "default": "./dist/cjs/http.js"
      }
    },
    "./mobx": {
      "import": {
        "types": "./dist/esm/mobx.d.ts",
        "default": "./dist/esm/mobx.js"
      },
      "require": {
        "types": "./dist/cjs/mobx.d.ts",
        "default": "./dist/cjs/mobx.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "yarn clean && tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-marker.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.cjs.tsbuildinfo",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src __tests__ scripts",
    "lint:fix": "eslint src __tests__ scripts --fix",
    "test": "vitest run",
    "test:pack": "yarn build && node scripts/pack-smoke.mjs"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "mobx": "^6.13.7",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "mobx": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kingstack/eslint-config": "workspace:*",
    "@kingstack/ts-config": "workspace:*",
    "@openfeature/core": "1.12.0",
    "@openfeature/server-sdk": "1.23.0",
    "@posthog/openfeature-node-provider": "0.1.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "eslint": "10.8.0",
    "mobx": "^6.13.7",
    "posthog-node": "5.52.4",
    "react": "19.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.1.4"
  }
}
