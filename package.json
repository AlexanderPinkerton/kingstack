{
  "private": true,
  "name": "kingstack",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "yarn workspace @kingstack/next dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "build:release-packages": "turbo run build $(bun scripts/get-public-packages.ts)",
    "lint": "yarn lint:fix",
    "lint:check": "eslint . && turbo run lint",
    "lint:fix": "yarn format && eslint . --fix && turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "yarn test:workbranch && yarn test:deploy && yarn test:supabase-provision && yarn test:vercel-config && turbo run test",
    "test:workbranch": "bun test scripts/utils/create-workbranch.test.ts",
    "test:deploy": "bun test scripts/deploy/nest-digitalocean/deployment.test.ts",
    "test:supabase-provision": "bun test scripts/deploy/supabase/*.test.ts",
    "test:vercel-config": "bun test scripts/deploy/vercel/*.test.ts",
    "test:create-kingstack": "bun scripts/test-create-kingstack.ts",
    "backend:enable": "bun scripts/enable-backend.ts",
    "local": "yarn env:local && yarn supabase:start",
    "docker:build-nest": "docker build -f apps/nest/Dockerfile -t kingstack-nest .",
    "docker:run-nest": "docker run --rm -p 3000:3000 --name kingstack-nest --env-file apps/nest/.env -d kingstack-nest",
    "docker:compose": "docker-compose up --build",
    "docker:compose:down": "docker-compose down",
    "prisma:generate": "yarn workspace @kingstack/prisma prisma generate",
    "prisma:migrate": "yarn workspace @kingstack/prisma prisma migrate dev",
    "prisma:deploy": "yarn workspace @kingstack/prisma prisma migrate deploy",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "bun scripts/supabase-status.ts",
    "supabase:list": "bun scripts/supabase-list-instances.ts",
    "supabase:check": "bun scripts/supabase-check-config.ts",
    "supabase:provision": "bun scripts/deploy/supabase.ts",
    "supabase:provision:get-secrets": "bun scripts/deploy/supabase/get-secrets.ts",
    "supabase:auth:configure": "bun scripts/deploy/supabase/configure-auth.ts",
    "supabase:reset": "supabase db reset",
    "supabase:auth:trigger:install": "bun --env-file=apps/nest/.env apps/nest/src/scripts/install-custom-user-trigger.ts",
    "supabase:auth:trigger:remove": "bun --env-file=apps/nest/.env apps/nest/src/scripts/remove-custom-user-trigger.ts",
    "supabase:auth:backfill": "bun --env-file=apps/nest/.env apps/nest/src/scripts/backfill-user-data.ts",
    "vercel": "vercel deploy",
    "vercel:prod": "vercel deploy --prod",
    "vercel:config:pull": "bun scripts/deploy/vercel/get-config.ts",
    "king-config": "bun packages/config/src/cli/index.ts",
    "env:local": "yarn king-config generate local",
    "env:development": "yarn king-config generate development",
    "env:production": "yarn king-config generate production",
    "config:check": "yarn king-config check --all",
    "config:check:local": "yarn king-config check local",
    "config:diff:local": "yarn king-config diff local",
    "config:envs": "yarn king-config env list",
    "workbranch": "bun scripts/utils/create-workbranch.ts",
    "deploy:nest": "bun scripts/deploy/nest-digitalocean.ts",
    "deploy:check-tools": "gh --version && yarn exec vercel --version && gh auth status && yarn exec vercel whoami",
    "deploy:sync-secrets": "yarn king-config sync",
    "deploy:sync-secrets:dev": "yarn king-config sync --env development",
    "deploy:sync-secrets:prod": "yarn king-config sync --env production",
    "deploy:sync-secrets:dry-run": "yarn king-config sync --dry-run"
  },
  "packageManager": "yarn@4.10.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@types/pg": "^8.15.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@iarna/toml": "^2.2.5",
    "@kingstack/config": "workspace:*",
    "@kingstack/eslint-config": "workspace:*",
    "@napi-rs/keyring": "1.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vercel": "58.1.0"
  }
}
