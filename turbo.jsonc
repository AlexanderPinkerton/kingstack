{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true,
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"],
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true,
    },
    // Depends on ^build so workspace packages have emitted their .d.ts files.
    // Without it, imports of those packages resolve to `any` and every
    // type-aware rule silently degrades — which reports phantom errors and
    // misses real ones. This builds dependencies only (small tsc libraries),
    // never the consuming app.
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eslint-config/index.mjs",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
      ],
      "outputs": [],
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eslint-config/index.mjs",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
      ],
      "outputs": [],
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": ["*.tsbuildinfo", "dist/*.tsbuildinfo"],
    },
    "test": {
      "outputs": [],
    },
  },
}
